# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.html
coverage.txt
coverage.xml
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Local documentation.
/AGENTS.md
/go/README.md

# Local legacy scripts and Python dependencies.
/ignore_python_code/
/sshfs_linux.txt

# Generated binaries, diagnostics, and Finder metadata.
/dist/
/ios-files
/go/dist/
ios-files-debug-*.jsonl
.DS_Store

# Local iOS backups and exports.
[Bb]ackup/
[Bb]ackups/
output/
exported-files/
camera_roll/
call_history.sqlite*
Info.plist
Manifest.plist
Manifest.db*
Status.plist
ios-files-manifest-*.db

# Local credentials.
.env.*
password.txt
